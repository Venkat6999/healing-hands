# ============================================================
#  Supabase credentials — Vercel + Supabase deployment
# ============================================================
#  Copy this file to .env  (NOT .env.example) and fill in the values.
#  Locally: used by `npm run seed`.
#  On Vercel: Project > Settings > Environment Variables — add BOTH.
#
#  Where to find them:
#    Dashboard > Project Settings > API
#      Project URL              -> SUPABASE_URL
#      service_role  (secret)   -> SUPABASE_SERVICE_ROLE_KEY
#
#  !! The service_role key bypasses all Row Level Security. It must
#  !! only ever exist in server-side environment variables. It must
#  !! NEVER be committed or placed in any file the browser downloads.
# ============================================================

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- admin sign-in ---
# There is NO default passcode. On the first sign-in the backend hashes this
# value into the database and only ever stores the hash. After that, change it
# from the admin panel (Settings & backup), which replaces the stored hash.
# If this is unset and the database has no passcode, sign-in is refused.
# Use at least 16 characters of something random.
ADMIN_PASSCODE=