{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/images/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/css/(.*)", "headers": { "Cache-Control": "public, max-age=3600" } },
    { "src": "/js/(.*)", "headers": { "Cache-Control": "public, max-age=3600" } },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
