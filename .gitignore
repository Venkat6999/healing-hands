# never commit real credentials or generated build artefacts
.env
.env.local
.env*.local
node_modules/
.vscode/
.vercel
*.log

# the admin passcode hash and patient records are machine-local state, not source
data/passcode.json
data/appointments.json

# NOTE: the leading slash matters. A bare `uploads/` would also match
# api/uploads/, which is where the /uploads/... redirect function lives --
# ignoring it silently removed that function from the repository.
/uploads/